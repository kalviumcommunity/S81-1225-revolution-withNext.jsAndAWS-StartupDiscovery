# Production Environment Configuration
# Production-grade configuration with security hardening

NODE_ENV=production

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.startupdiscovery.com/api
NEXT_PUBLIC_APP_URL=https://startupdiscovery.com

# Database
# Injected via GitHub Secrets during CI/CD pipeline
DATABASE_URL=${DATABASE_URL_PRODUCTION}

# OAuth Configuration - Use production OAuth apps
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID_PRODUCTION}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET_PRODUCTION}

# OAuth Configuration
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID_PRODUCTION}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET_PRODUCTION}

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_DEBUG_MODE=false

# Logging
LOG_LEVEL=warn
