# Development Environment Configuration
# Local development with relaxed settings

NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Use local database for development
DATABASE_URL=postgresql://user:password@localhost:5432/startupdiscovery_dev

# OAuth Configuration - Use test apps for local development
GITHUB_CLIENT_ID=your-github-dev-client-id
GITHUB_CLIENT_SECRET=your-github-dev-client-secret

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-dev-client-id
GOOGLE_CLIENT_SECRET=your-google-dev-client-secret

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_DEBUG_MODE=true

# Logging
LOG_LEVEL=debug
