# Staging Environment Configuration
# Pre-production environment with production-like settings

NODE_ENV=staging

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://staging-api.example.com/api
NEXT_PUBLIC_APP_URL=https://staging.example.com

# Database
# Injected via GitHub Secrets during CI/CD pipeline
DATABASE_URL=${DATABASE_URL_STAGING}

# OAuth Configuration - Use staging OAuth apps
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID_STAGING}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET_STAGING}

# OAuth Configuration
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID_STAGING}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET_STAGING}

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_DEBUG_MODE=false

# Logging
LOG_LEVEL=info
