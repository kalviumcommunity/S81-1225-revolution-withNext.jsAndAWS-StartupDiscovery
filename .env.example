# ============================================
# Environment Variables - StartupDiscovery
# ============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# Node Environment
NODE_ENV=production

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@db:5432/startupdiscovery

# Alternative PostgreSQL URLs for different environments:
# Local: postgresql://postgres:password@localhost:5432/startupdiscovery
# Docker: postgresql://postgres:postgres@db:5432/startupdiscovery
# Cloud (example): postgresql://user:pass@host.region.rds.amazonaws.com:5432/dbname?schema=public

# Prisma Configuration
# Direct connection to database (for migrations)
DIRECT_DATABASE_URL=postgresql://postgres:postgres@db:5432/startupdiscovery

# Redis Configuration
REDIS_URL=redis://redis:6379

# Application Configuration
PORT=3000
HOSTNAME=0.0.0.0

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-session-secret-change-this-in-production
BCRYPT_ROUNDS=10

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@startupdiscovery.com

# File Upload & Storage (AWS S3 or similar)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=startupdiscovery-uploads

# Optional: External APIs
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Analytics & Monitoring
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxx@sentry.io/xxx
